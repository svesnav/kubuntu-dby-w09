<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>MatePad 11 Linux</vendor>
  <action id="org.matepad.boot-harmonyos">
    <description>Restart the tablet into HarmonyOS</description>
    <message>Restarting into HarmonyOS writes its boot images.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/sbin/matepad-boot-harmonyos</annotate>
  </action>
</policyconfig>
