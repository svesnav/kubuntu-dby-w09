# Fine-grained personal access token, repositories linux-dby-w09 and
# kubuntu-dby-w09, permission "Administration: Read and write" (it only
# fetches runner registration tokens).
GITHUB_PAT=
# Label the workflows ask for (repository variable RUNNER).
RUNNER_LABELS=matepad-builder
# Shown in the repository's runner list, with the repository name appended.
RUNNER_NAME=home-server
