#!/bin/sh
# /usr/local/sbin/matepad-modem-firmware: firmware that device-files/firmware.txt
# lists but the install predates (a package update added it) is copied from
# the tablet's modem partition (image/*, mounted read-only), like the installer
# does. Run by the package's postinst; the drivers pick it up at the next boot.
set -eu
FW=/usr/lib/firmware/qcom/sm8250/huawei/dby-w09
LIST=/usr/share/matepad/device-files/firmware.txt
PART=/dev/disk/by-partlabel/modem

grep -q dby-w09 /proc/device-tree/compatible 2>/dev/null || exit 0	# the tablet only (not an image build)
missing=$(grep -v '^#' "$LIST" | grep . | while read -r f; do [ -e "$FW/$f" ] || echo "$f"; done)
[ -n "$missing" ] || exit 0
if [ ! -e "$PART" ]; then
	echo "matepad-modem-firmware: no modem partition here; the installer's Update copies the firmware"
	exit 0
fi
M=$(mktemp -d)
trap 'umount "$M" 2>/dev/null; rmdir "$M"' EXIT
mount -o ro "$PART" "$M"
mkdir -p "$FW"
for f in $missing; do
	if [ -e "$M/image/$f" ]; then
		install -m 644 "$M/image/$f" "$FW/" && echo "matepad-modem-firmware: $f"
	fi
done
